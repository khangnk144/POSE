# Copy to .env.local and fill in. Local Supabase values come from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty to lock AI features in the UI.
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT_PER_USER=40
# Claude model for AI autofill/suggest; claude-haiku-5-5 is cheaper
AI_MODEL=claude-sonnet-5-5
# Shared secret for the daily /api/health cron call.
CRON_SECRET=
